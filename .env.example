# PostgreSQL connection string used by Prisma.
# Example (local): postgresql://postgres:password@localhost:5432/avoras
# Example (hosted, e.g. Neon/Supabase/Railway): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/avoras"

# Used to build absolute URLs (order confirmation emails, sitemaps, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: bKash Merchant API credentials (for real payment gateway integration)
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""

# Optional: for a real admin login (NextAuth / custom JWT), add a secret here
# AUTH_SECRET="generate-a-random-32-char-string"
